NODE_ENV=development

WEB_PORT=5173
API_PORT=4000
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000
VITE_API_ORIGIN=http://localhost:4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=orbital_directive
DB_USER=orbital_user
DB_PASSWORD=orbital_password
DB_ROOT_PASSWORD=root_password
DATABASE_URL=mysql://orbital_user:orbital_password@127.0.0.1:3306/orbital_directive

SESSION_COOKIE_NAME=orbital_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_TTL_HOURS=168
SESSION_SECRET=change_me_with_a_long_random_secret

CSRF_COOKIE_NAME=orbital_csrf
CSRF_HEADER_NAME=x-csrf-token

CSP_CONNECT_SRC=self http://localhost:4000
CSP_IMG_SRC=self data:
CSP_MEDIA_SRC=self

LOG_LEVEL=info

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_CRITICAL_MAX=15

DEMO_EMAIL=demo@orbital.directive
DEMO_PASSWORD=DemoPass123!
DEMO_USER_NAME=Commander Demo

IDEMPOTENCY_TTL_MINUTES=30
